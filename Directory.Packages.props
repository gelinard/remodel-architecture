<Project>

  <!-- Central package management: every package version lives in this one file. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup Label="Runtime">
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.15" />
  </ItemGroup>

  <ItemGroup Label="Azure Functions host">
    <PackageVersion Include="Microsoft.Azure.Functions.Worker" Version="2.52.0" />
    <PackageVersion Include="Microsoft.Azure.Functions.Worker.Extensions.Http.AspNetCore" Version="2.1.1" />
    <PackageVersion Include="Microsoft.Azure.Functions.Worker.Extensions.Storage.Queues" Version="5.5.5" />
    <PackageVersion Include="Microsoft.Azure.Functions.Worker.Sdk" Version="2.1.0" />
  </ItemGroup>

  <ItemGroup Label="Data">
    <PackageVersion Include="Dapper" Version="2.1.100" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.15" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.15" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.4" />
    <!-- Stay on the 6.1 line that EF Core 10 is built against, so both adapters use the same driver. -->
    <PackageVersion Include="Microsoft.Data.SqlClient" Version="6.1.8" />
  </ItemGroup>

  <ItemGroup Label="Tests">
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.Testing" Version="10.11.1" />
    <PackageVersion Include="NSubstitute" Version="6.2.0" />
    <PackageVersion Include="Shouldly" Version="4.3.0" />
    <PackageVersion Include="Testcontainers.MsSql" Version="4.17.0" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.17.0" />
    <PackageVersion Include="TngTech.ArchUnitNET" Version="0.13.5" />
    <PackageVersion Include="xunit.v3" Version="4.0.3" />
  </ItemGroup>

</Project>
